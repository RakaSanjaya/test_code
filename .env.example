# Copy to .env (gitignored) for production-like runs. Dev/test use the values in config/*.exs.
# Generate secrets with: mix phx.gen.secret 48
DATABASE_URL=ecto://postgres:postgres@localhost:55432/messaging_gateway_prod
SECRET_KEY_BASE=replace_me_generate_with_mix_phx_gen_secret_48
WEBHOOK_SECRET=replace_me_generate_with_mix_phx_gen_secret_48
API_KEY_PEPPER=replace_me_generate_with_mix_phx_gen_secret_48
PHX_HOST=localhost
PORT=4000
# Host port docker compose publishes Postgres on (dev/test config reads it too)
DB_PORT=55432
